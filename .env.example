# Copy to Railway → your service → Variables. Never commit real values.
CHAIN=testnet                      # testnet (46630) or mainnet (4663)
# RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/<key>   # recommended for production
LAUNCHPAD_ADDRESS=0x...            # from contracts/deployments/<network>.json
START_BLOCK=0                      # deploy block from the same file
PUBLIC_URL=https://your-app.up.railway.app
DATABASE_URL=${{Postgres.DATABASE_URL}}
SESSION_SECRET=                    # long random string
NODE_ENV=production
PRICE_SOURCE=coinbase              # or 'fixed' with ETH_USD_FALLBACK
ETH_USD_FALLBACK=3000
REEL_COST_USD=25
VIDEO_PROVIDER=none                # none | mock | webhook
# VIDEO_WEBHOOK_URL=https://...    # your renderer (see DEPLOY.md)
# VIDEO_WEBHOOK_SECRET=            # shared HMAC secret
